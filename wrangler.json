{
	"name": "yidel-dev",
	"compatibility_date": "2026-09-03",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"main": "./dist/_worker.js/index.js",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"routes": [
		{
			"pattern": "yidel.dev",
			"custom_domain": true
		},
		{
			"pattern": "yedidimdispatch.yidel.dev",
			"custom_domain": true
		}
	],
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true
}
