---
const logoUrl = 'https://raw.githubusercontent.com/brownyidel/YB-portfolio/main/assets/yb-logo.png';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#080b11" />
		<meta name="description" content="Yidel Brown — web development, software and automation." />
		<meta name="robots" content="index,follow" />
		<title>Yidel Brown — Developer</title>
		<style is:global>
			:root {
				color-scheme: dark;
				--bg: #07090e;
				--panel: rgba(18, 22, 31, 0.68);
				--panel-border: rgba(255, 255, 255, 0.09);
				--text: #f5f6f8;
				--muted: #a9afba;
				--gold: #e5b761;
				--gold-soft: #b8873d;
				--silver: #e8ebef;
			}

			* { box-sizing: border-box; }

			html { background: var(--bg); scroll-behavior: smooth; }

			body {
				margin: 0;
				min-height: 100vh;
				font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
				color: var(--text);
				background:
					radial-gradient(circle at 72% 36%, rgba(218, 164, 75, 0.11), transparent 30%),
					radial-gradient(circle at 18% 80%, rgba(177, 190, 210, 0.06), transparent 28%),
					linear-gradient(145deg, #05070a 0%, #0b0f16 46%, #080a0f 100%);
				overflow-x: hidden;
			}

			body::before {
				content: "";
				position: fixed;
				inset: 0;
				pointer-events: none;
				opacity: 0.32;
				background-image:
					linear-gradient(rgba(255,255,255,.025) 1px, transparent 1px),
					linear-gradient(90deg, rgba(255,255,255,.025) 1px, transparent 1px);
				background-size: 48px 48px;
				mask-image: linear-gradient(to bottom, black, transparent 85%);
			}

			.shell {
				position: relative;
				min-height: 100svh;
				display: grid;
				grid-template-rows: auto 1fr auto;
				isolation: isolate;
			}

			.glow {
				position: fixed;
				width: 38rem;
				height: 38rem;
				border-radius: 50%;
				background: rgba(226, 176, 88, 0.07);
				filter: blur(90px);
				top: 8%;
				right: -12rem;
				pointer-events: none;
				z-index: -1;
			}

			header,
			footer {
				width: min(1180px, calc(100% - 48px));
				margin: 0 auto;
			}

			header {
				display: flex;
				align-items: center;
				justify-content: space-between;
				padding: 28px 0 10px;
			}

			.wordmark {
				font-size: 0.78rem;
				font-weight: 750;
				letter-spacing: 0.22em;
				text-transform: uppercase;
				color: #f4f5f7;
			}

			.wordmark span { color: var(--gold); }

			.status {
				display: inline-flex;
				align-items: center;
				gap: 9px;
				font-size: .75rem;
				letter-spacing: .1em;
				text-transform: uppercase;
				color: #aeb5c0;
			}

			.status-dot {
				width: 7px;
				height: 7px;
				border-radius: 50%;
				background: var(--gold);
				box-shadow: 0 0 0 5px rgba(229,183,97,.08), 0 0 18px rgba(229,183,97,.35);
			}

			main {
				width: min(1180px, calc(100% - 48px));
				margin: 0 auto;
				display: grid;
				grid-template-columns: minmax(0, 1.05fr) minmax(340px, .95fr);
				align-items: center;
				gap: clamp(34px, 6vw, 92px);
				padding: 52px 0 64px;
			}

			.copy { max-width: 690px; }

			.eyebrow {
				display: inline-flex;
				align-items: center;
				gap: 12px;
				margin-bottom: 22px;
				font-size: .78rem;
				font-weight: 720;
				letter-spacing: .18em;
				text-transform: uppercase;
				color: var(--gold);
			}

			.eyebrow::before {
				content: "";
				width: 34px;
				height: 1px;
				background: linear-gradient(90deg, transparent, var(--gold));
			}

			h1 {
				margin: 0;
				max-width: 760px;
				font-size: clamp(3.2rem, 7.1vw, 6.9rem);
				line-height: .94;
				letter-spacing: -.055em;
				font-weight: 780;
			}

			h1 .accent {
				background: linear-gradient(100deg, #f6e2b8 0%, #d9a651 44%, #f0d39a 100%);
				-webkit-background-clip: text;
				background-clip: text;
				color: transparent;
			}

			.lead {
				margin: 30px 0 0;
				max-width: 620px;
				font-size: clamp(1rem, 1.6vw, 1.22rem);
				line-height: 1.72;
				color: var(--muted);
			}

			.capabilities {
				margin-top: 34px;
				display: flex;
				flex-wrap: wrap;
				gap: 10px;
			}

			.capabilities span {
				border: 1px solid var(--panel-border);
				background: rgba(255,255,255,.025);
				backdrop-filter: blur(8px);
				border-radius: 999px;
				padding: 9px 13px;
				font-size: .78rem;
				letter-spacing: .045em;
				color: #c6cbd3;
			}

			.visual {
				position: relative;
				display: grid;
				place-items: center;
				min-height: 520px;
				perspective: 1000px;
			}

			.logo-stage {
				position: relative;
				width: min(100%, 520px);
				aspect-ratio: 1;
				display: grid;
				place-items: center;
				transition: transform .18s ease-out;
				will-change: transform;
			}

			.logo-stage::before,
			.logo-stage::after {
				content: "";
				position: absolute;
				border-radius: 50%;
				pointer-events: none;
			}

			.logo-stage::before {
				inset: -7%;
				border: 1px solid rgba(226, 176, 88, .16);
				box-shadow: inset 0 0 80px rgba(226,176,88,.025);
				animation: breathe 5s ease-in-out infinite;
			}

			.logo-stage::after {
				inset: -14%;
				border: 1px dashed rgba(223, 227, 233, .08);
				animation: spin 30s linear infinite;
			}

			.logo {
				position: relative;
				z-index: 2;
				width: 100%;
				height: 100%;
				object-fit: contain;
				border-radius: 50%;
				filter: drop-shadow(0 26px 60px rgba(0,0,0,.48)) drop-shadow(0 0 26px rgba(221,169,77,.08));
			}

			.orbit-dot {
				position: absolute;
				z-index: 3;
				top: -7.7%;
				left: 50%;
				width: 9px;
				height: 9px;
				border-radius: 50%;
				background: var(--gold);
				box-shadow: 0 0 20px rgba(229,183,97,.65);
			}

			.circuit {
				position: absolute;
				inset: auto -8% 4% auto;
				width: 180px;
				height: 110px;
				opacity: .46;
			}

			.circuit i {
				position: absolute;
				right: 0;
				height: 1px;
				background: linear-gradient(90deg, transparent, rgba(230,184,99,.7));
			}
			.circuit i::after {
				content: "";
				position: absolute;
				right: -3px;
				top: -3px;
				width: 7px;
				height: 7px;
				border: 1px solid var(--gold);
				border-radius: 50%;
				background: #0a0d12;
			}
			.circuit i:nth-child(1) { top: 20px; width: 130px; }
			.circuit i:nth-child(2) { top: 54px; width: 92px; }
			.circuit i:nth-child(3) { top: 88px; width: 150px; }

			footer {
				display: flex;
				justify-content: space-between;
				align-items: center;
				gap: 20px;
				padding: 18px 0 28px;
				font-size: .72rem;
				letter-spacing: .08em;
				text-transform: uppercase;
				color: #6f7682;
			}

			footer strong { color: #9fa6b1; font-weight: 600; }

			@keyframes spin { to { transform: rotate(360deg); } }
			@keyframes breathe {
				0%, 100% { transform: scale(1); opacity: .75; }
				50% { transform: scale(1.025); opacity: 1; }
			}

			@media (max-width: 860px) {
				header, main, footer { width: min(100% - 32px, 680px); }
				header { padding-top: 20px; }
				main {
					grid-template-columns: 1fr;
					gap: 18px;
					padding-top: 34px;
					text-align: center;
				}
				.copy { margin: 0 auto; }
				.eyebrow { justify-content: center; }
				.lead { margin-left: auto; margin-right: auto; }
				.capabilities { justify-content: center; }
				.visual { order: -1; min-height: 0; padding: 18px 36px 26px; }
				.logo-stage { width: min(78vw, 390px); }
				.circuit { display: none; }
				h1 { font-size: clamp(3rem, 13vw, 5.7rem); }
				footer { margin-top: 14px; }
			}

			@media (max-width: 520px) {
				.status { display: none; }
				main { padding-top: 14px; padding-bottom: 40px; }
				.visual { padding: 10px 48px 14px; }
				.logo-stage::after { inset: -10%; }
				.logo-stage::before { inset: -4%; }
				.orbit-dot { top: -4.7%; }
				.eyebrow { margin-bottom: 16px; }
				.lead { margin-top: 22px; line-height: 1.62; }
				.capabilities { margin-top: 26px; gap: 8px; }
				.capabilities span { font-size: .72rem; padding: 8px 11px; }
				footer { justify-content: center; text-align: center; }
				footer span:last-child { display: none; }
			}

			@media (prefers-reduced-motion: reduce) {
				.logo-stage::before,
				.logo-stage::after { animation: none; }
				.logo-stage { transition: none; }
			}
		</style>
	</head>
	<body>
		<div class="shell">
			<div class="glow" aria-hidden="true"></div>
			<header>
				<div class="wordmark">YIDEL<span>.DEV</span></div>
				<div class="status"><span class="status-dot"></span>Web · Software · Automation</div>
			</header>

			<main>
				<section class="copy" aria-labelledby="hero-title">
					<div class="eyebrow">Yidel Brown · Developer</div>
					<h1 id="hero-title">Building useful things <span class="accent">for the web</span> and beyond.</h1>
					<p class="lead">
						Websites, software, automation and custom digital tools — designed to be clean, practical and reliable.
					</p>
					<div class="capabilities" aria-label="Areas of work">
						<span>Web Development</span>
						<span>Software</span>
						<span>Automation</span>
						<span>Digital Tools</span>
					</div>
				</section>

				<section class="visual" aria-label="Yidel Brown logo">
					<div class="logo-stage" id="logoStage">
						<img class="logo" src={logoUrl} alt="YB — Yidel Brown, Develop Automate Solve" />
						<span class="orbit-dot" aria-hidden="true"></span>
						<div class="circuit" aria-hidden="true"><i></i><i></i><i></i></div>
					</div>
				</section>
			</main>

			<footer>
				<span>© 2026 <strong>Yidel Brown</strong></span>
				<span>Develop · Automate · Solve</span>
			</footer>
		</div>

		<script>
			const stage = document.getElementById('logoStage');
			const finePointer = window.matchMedia('(pointer: fine)').matches;
			const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

			if (stage && finePointer && !reducedMotion) {
				window.addEventListener('pointermove', (event) => {
					const x = (event.clientX / window.innerWidth - 0.5) * 9;
					const y = (event.clientY / window.innerHeight - 0.5) * -9;
					stage.style.transform = `rotateX(${y}deg) rotateY(${x}deg) translateZ(0)`;
				});
				window.addEventListener('pointerleave', () => {
					stage.style.transform = 'rotateX(0deg) rotateY(0deg)';
				});
			}
		</script>
	</body>
</html>
